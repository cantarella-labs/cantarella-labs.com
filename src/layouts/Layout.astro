---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';

const { title = 'Cantarella Labs', description = '' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Insights' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header>
      <a href="/" class="brand">Cantarella Labs</a>
      <nav>
        {nav.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Cantarella Labs</p>
    </footer>

    <script>
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        for (const group of document.querySelectorAll('[data-reveal-group]')) {
          [...group.children].forEach((el, i) => {
            el.setAttribute('data-reveal', '');
            (el as HTMLElement).style.setProperty('--reveal-delay', `${i * 60}ms`);
          });
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        for (const el of document.querySelectorAll('[data-reveal]')) io.observe(el);
      } else {
        for (const el of document.querySelectorAll('[data-reveal]')) el.classList.add('is-visible');
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --max: 72rem;
    --font-body: 'Inter Variable', system-ui, -apple-system, sans-serif;
    --font-display: 'Source Serif 4 Variable', Georgia, serif;
    --bg: #f8fafc;
    --ink: #1e293b;
    --muted: #526175;
    --accent: #075985;
    --accent-strong: #0c4a6e;
    --accent-ink: #ffffff;
    --border: #e2e8f0;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1520;
      --ink: #e2e8f0;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-strong: #7dd3fc;
      --accent-ink: #04263b;
      --border: #243244;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  h1, h2, h3 {
    font-family: var(--font-display);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); }
  h2 { font-size: 1.5rem; margin-top: 2.5rem; }
  main p { max-width: 70ch; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.25rem;
  }
  .card-grid--lg {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
  }
  .chip {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }
  a.chip:hover { color: var(--accent); border-color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-reveal] {
      opacity: 0;
      translate: 0 14px;
      transition: opacity 0.5s ease, translate 0.5s ease;
      transition-delay: var(--reveal-delay, 0s);
    }
    html.js [data-reveal].is-visible {
      opacity: 1;
      translate: 0 0;
    }
  }
  a { color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent-strong); }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: var(--max);
    width: 100%;
    margin: 0 auto;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand:hover { color: var(--accent); }
  nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--accent); }
  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  main { flex: 1; max-width: var(--max); width: 100%; margin: 0 auto; padding: 1.5rem; }
  .cta {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .cta:hover { background: var(--accent-strong); color: var(--accent-ink); }
  .cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  footer {
    max-width: var(--max); width: 100%; margin: 0 auto;
    padding: 2rem 1.5rem; color: var(--muted); font-size: 0.9rem;
    border-top: 1px solid var(--border);
  }
</style>
