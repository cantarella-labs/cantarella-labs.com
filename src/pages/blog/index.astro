---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Insights — Cantarella Labs" description="Notes and articles from Cantarella Labs.">
  <h1>Insights</h1>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
        </time>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li { margin-bottom: 1.75rem; }
  .posts a { font-size: 1.2rem; font-weight: 600; text-decoration: none; }
  .posts time { display: block; color: #555; font-size: 0.85rem; margin: 0.15rem 0; }
  .posts p { margin: 0.25rem 0 0; color: #333; }
</style>
