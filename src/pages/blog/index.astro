---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaseCard from '../../components/CaseCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Insights — Cantarella Labs" description="Notes and articles from Cantarella Labs.">
  <h1>Insights</h1>
  <p class="intro">Notes on water, models and instruments.</p>
  <div class="card-grid--lg" data-reveal-group>
    {posts.map((post) => (
      <CaseCard
        variant="rich"
        href={`/blog/${post.id}/`}
        title={post.data.title}
        blurb={post.data.description}
        image={post.data.image?.url}
        placeholder={post.data.tags[0] ?? 'notes'}
        tag={post.data.tags[0]}
        date={post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
      />
    ))}
  </div>
</Layout>

<style>
  .intro { color: var(--muted); margin-top: 0; }
  .card-grid--lg { margin-top: 2rem; }
</style>
