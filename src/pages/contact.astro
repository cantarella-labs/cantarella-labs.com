---
import Layout from "../layouts/Layout.astro";
// Get a free access key at https://web3forms.com (verify vcantarella@cantarellalabs.com once).
// Submissions are emailed there; no backend to run.
const ACCESS_KEY = "8c47c0d2-273a-4747-91de-e09ff9502933";
---

<Layout
  title="Contact — Cantarella Labs"
  description="Get in touch with Cantarella Labs."
>
  <h1>Contact</h1>
  <p>Tell me about your project and I'll get back to you.</p>

  <div class="contact-grid">
  <form id="contact-form">
    <input type="hidden" name="access_key" value={ACCESS_KEY} />
    <input
      type="hidden"
      name="subject"
      value="New enquiry from cantarellalabs.com"
    />
    <!-- ponytail: honeypot for bots; real users never see it -->
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
    />

    <label>Name<input type="text" name="name" required /></label>
    <label>Email<input type="email" name="email" required /></label>
    <label>Message<textarea name="message" rows="6" required></textarea></label>

    <button type="submit">Send</button>
    <p id="status" role="status" aria-live="polite"></p>
  </form>

  <aside class="contact-info">
    <h2>Prefer email?</h2>
    <p><a href="mailto:vcantarella@cantarellalabs.com">vcantarella@cantarellalabs.com</a></p>
    <p>I usually reply within one working day with a first assessment and, if it fits, a short call proposal.</p>
    <p class="see-also">
      Not sure yet? Browse the <a href="/services/">services</a> or the
      <a href="/case-studies/">case studies</a> first.
    </p>
  </aside>
  </div>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("status")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.textContent = "Sending…";
    const res = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: new FormData(form),
    });
    if (res.ok) {
      form.reset();
      status.textContent = "Thanks — I'll be in touch soon.";
    } else {
      status.textContent =
        "Something went wrong. Email vcantarella@cantarellalabs.com directly.";
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .contact-info h2 { margin-top: 0; font-size: 1.2rem; }
  .contact-info { color: var(--muted); }
  form {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-weight: 600;
  }
  input,
  textarea {
    font: inherit;
    padding: 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--ink);
    border-radius: 6px;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  button {
    justify-self: start;
    padding: 0.7rem 1.4rem;
    background: var(--accent);
    color: var(--accent-ink);
    border: 0;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  button:hover { background: var(--accent-strong); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #status {
    color: var(--muted);
    font-weight: 600;
  }
  .hidden {
    display: none;
  }
</style>
