---
import Layout from "../../layouts/Layout.astro";

const pages = import.meta.glob<{ meta?: { title: string; blurb: string } }>(
  "./*.astro",
  { eager: true },
);
const cases = Object.entries(pages).flatMap(([path, page]) =>
  page.meta
    ? [
        {
          href: `/case-studies/${path.replace("./", "").replace(".astro", "")}/`,
          title: page.meta.title,
          body: page.meta.blurb,
        },
      ]
    : [],
);
---

<Layout title="Case Studies — Cantarella Labs" description="Selected services and projects.">
  <h1>Case Studies</h1>
  {cases.map((c) => (
    <section>
      <h2><a href={c.href}>{c.title}</a></h2>
      <p>{c.body}</p>
    </section>
  ))}
  <p><a href="/contact/">Discuss a project &rarr;</a></p>
</Layout>
