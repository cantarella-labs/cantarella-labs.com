---
import Layout from "../../layouts/Layout.astro";
import CaseCard from "../../components/CaseCard.astro";
import { getCollection } from "astro:content";

const tagNames: Record<string, string> = {
  forecasting: "Forecasting",
  modeling: "Modeling",
  instrumentation: "Instrumentation",
  hydrogeology: "Hydrogeology",
  "water-resources": "Water resources",
};

const cases = (await getCollection("caseStudies"))
  .map((c) => ({
    href: `/case-studies/${c.id}/`,
    title: c.data.title,
    blurb: c.data.blurb,
    image: c.data.image,
    imageBg: c.data.imageBg,
    tag: c.data.service ? tagNames[c.data.service] : undefined,
    featured: c.data.featured,
  }))
  .sort((a, b) => Number(b.featured) - Number(a.featured));
---

<Layout title="Case Studies — Cantarella Labs" description="Selected services and projects.">
  <h1>Case Studies</h1>
  <p class="intro">Selected projects bringing technology and groundwater science closer.</p>
  <div class="case-grid" data-reveal-group>
    {cases.map((c) => (
      <CaseCard
        variant="rich"
        href={c.href}
        title={c.title}
        blurb={c.blurb}
        image={c.image}
        imageBg={c.imageBg}
        tag={c.tag}
      />
    ))}
  </div>
  <p class="outro"><a href="/contact/">Discuss a project &rarr;</a></p>
</Layout>

<style>
  .intro { color: var(--muted); margin-top: 0; }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .case-grid { grid-template-columns: repeat(3, 1fr); }
    .case-grid > :global(:first-child) { grid-column: span 2; }
  }
  .outro { margin-top: 2.5rem; font-weight: 600; }
</style>
