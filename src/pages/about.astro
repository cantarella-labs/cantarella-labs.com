---
import Layout from "../layouts/Layout.astro";

const links = [
  { href: "https://github.com/vcantarella", label: "GitHub" },
  { href: "https://orcid.org/0009-0005-9495-6349", label: "ORCID" },
  {
    href: "https://www.linkedin.com/in/vitor-cantarella-81803693/",
    label: "LinkedIn",
  },
];

const tags = [
  "groundwater",
  "hydrogeology",
  "reactive transport",
  "numerical modeling",
  "forecasting",
  "field instrumentation",
  "Julia",
  "Python",
];
---

<Layout
  title="About — Cantarella Labs"
  description="Vitor Cantarella — hydrogeologist building numerical models and field instruments for water."
>
  <section class="profile">
    <img
      src="/about/vitor.png"
      alt="Portrait of Vitor Cantarella"
      width="420"
      height="420"
    />
    <div>
      <h1>Vitor Cantarella</h1>
      <p class="tagline">
        Hydrogeologist · PhD candidate, University of Kassel
      </p>
      <p>
        I design solutions based on data and models to tackle water challenges.
        From Brazil, based in Kassel, Germany.
      </p>
      <p class="social">
        {
          links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" aria-label={l.label}>
              {l.label === "GitHub" && (
                <svg viewBox="0 0 16 16" width="26" height="26" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </svg>
              )}
              {l.label === "ORCID" && (
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z" />
                </svg>
              )}
              {l.label === "LinkedIn" && (
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
                </svg>
              )}
            </a>
          ))
        }
      </p>
    </div>
  </section>

  <svg
    viewBox="0 0 920 220"
    role="img"
    aria-label="Field data from wells and sensors goes into numerical models, tailored for your need"
    style="width:100%;height:auto;font-size:16px;font-family:'Bradley Hand','Segoe Print','Comic Sans MS',cursive;"
  >
    <!-- field data box (rough double stroke) -->
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M28,42 C95,38 170,40 246,43 C250,85 249,130 245,168 C175,172 95,171 26,167 C23,125 24,80 28,42 Z"/>
      <path d="M30,45 C100,42 175,43 243,45 C246,88 246,128 243,165 C170,168 100,168 29,164 C27,122 26,82 30,45 Z" stroke-opacity="0.45"/>
      <!-- rain cloud -->
      <path d="M60,75 C54,63 66,54 78,58 C82,46 100,44 106,55 C118,52 128,62 122,72 C116,81 68,83 60,75 Z"/>
      <path d="M72,90 L69,99 M90,90 L87,99 M108,88 L105,97"/>
      <!-- ground surface with grass -->
      <path d="M45,122 C90,119 160,119 228,122"/>
      <path d="M58,122 L60,114 M64,122 L67,115 M200,122 L202,114 M207,122 L210,115"/>
      <!-- monitoring well -->
      <path d="M138,122 L138,158 M152,122 L152,158 M138,158 L152,158"/>
      <path d="M134,122 L156,122 M141,105 L149,105 M141,105 L141,122 M149,105 L149,122"/>
      <!-- water table + flow -->
      <path d="M46,140 C70,136 100,138 130,140 M160,140 C185,138 210,139 227,141" stroke-dasharray="7 6"/>
      <path d="M141,150 L149,150"/>
    </g>
    <text x="137" y="196" text-anchor="middle" fill="currentColor">field data</text>

    <!-- rough arrow -->
    <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none">
      <path d="M262,104 C285,102 305,103 325,105"/>
      <path d="M315,97 C320,100 324,103 327,105 C323,108 319,111 314,114"/>
    </g>

    <!-- models box (blue rough + hachure, like the frost figure) -->
    <g fill="none" stroke="#4d94cc" stroke-width="2" stroke-linecap="round">
      <path d="M348,42 C420,38 500,40 570,43 C574,85 573,130 569,169 C495,173 420,172 346,168 C343,126 344,82 348,42 Z"/>
      <path d="M351,45 C425,42 498,43 567,46 C570,88 569,128 566,166 C492,169 425,168 349,164 C347,122 347,84 351,45 Z" stroke-opacity="0.5"/>
    </g>
    <g stroke="#4d94cc" stroke-width="1" stroke-opacity="0.3">
      <path d="M360,165 L455,44 M385,166 L480,45 M410,167 L505,46 M435,168 L530,47 M460,168 L555,48 M485,169 L566,60 M510,169 L568,95 M535,169 L568,130"/>
    </g>
    <g fill="none" stroke="#4d94cc" stroke-width="2" stroke-linecap="round">
      <!-- axes -->
      <path d="M382,70 L382,132 L536,132"/>
      <!-- wavy model curve -->
      <path d="M382,112 C405,90 425,120 448,98 C470,78 495,108 536,84"/>
      <!-- data points -->
      <circle cx="405" cy="103" r="3"/><circle cx="448" cy="100" r="3"/>
      <circle cx="490" cy="94" r="3"/><circle cx="520" cy="88" r="3"/>
    </g>
    <text x="459" y="196" text-anchor="middle" fill="#4d94cc" font-weight="bold">models</text>

    <!-- rough arrow -->
    <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none">
      <path d="M585,104 C608,102 628,103 648,105"/>
      <path d="M638,97 C643,100 647,103 650,105 C646,108 642,111 637,114"/>
    </g>

    <!-- answers box (rough double stroke) -->
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M672,42 C730,38 840,40 894,43 C898,85 897,130 893,168 C830,172 735,171 670,167 C667,125 668,80 672,42 Z"/>
      <path d="M674,45 C735,42 838,43 891,45 C894,88 894,128 891,165 C828,168 740,168 673,164 C671,122 670,82 674,45 Z" stroke-opacity="0.45"/>
      <!-- water drop -->
      <path d="M724,66 C734,80 742,92 742,102 C742,113 734,120 724,120 C714,120 706,113 706,102 C706,92 714,80 724,66 Z"/>
      <!-- big checkmark -->
      <path d="M792,96 C800,104 806,111 812,118 C824,96 836,78 852,64" stroke-width="3"/>
    </g>
    <text x="782" y="196" text-anchor="middle" fill="currentColor">answers you need</text>
  </svg>

  <ul class="stats">
    <li><strong>4</strong> peer-reviewed publications</li>
    <li><strong>10+</strong> groundwater numerical models</li>
    <li><strong>3</strong> countries worked in — BR · PT · DE</li>
  </ul>

  <ul class="tags">
    {tags.map((t) => <li>{t}</li>)}
  </ul>
</Layout>

<style>
  .profile {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 1.5rem 0 2rem;
  }
  .profile img {
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    border: 1px solid var(--border);
  }
  .profile div {
    flex: 1;
    min-width: 16rem;
  }
  .profile h1 {
    margin-bottom: 0.25rem;
  }
  .tagline {
    color: var(--muted);
    font-weight: 600;
    margin-top: 0;
  }
  .social {
    display: flex;
    gap: 1rem;
  }
  .social a {
    color: var(--muted);
  }
  .social a:hover {
    color: var(--accent);
  }
  .stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }
  .stats strong {
    display: block;
    font-size: 1.6rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
